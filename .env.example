# App authentication credentials
# Generate APP_PASSWORD_HASH with: python set_password.py
APP_USERNAME=admin
APP_PASSWORD_HASH=paste_hash_from_set_password_py_here
APP_SECRET_KEY=change-this-to-a-random-string-at-least-32-chars

# --- Nextcloud vault (Leads 2.0) ------------------------------------------
# Bot account with share access to the artwork vault. Use an app password from
# Nextcloud Settings -> Security, never a login password.
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USER=bot@example.com
NEXTCLOUD_APP_PASSWORD=paste_app_password_here
# Folder the browser is scoped to. Nothing outside it is reachable.
NEXTCLOUD_ROOT=Leads 2.0
# How often the live watcher asks Nextcloud "what changed?" (seconds).
NEXTCLOUD_POLL_SECONDS=4
# How far back the feed looks on start-up, so a restart shows recent arrivals.
NEXTCLOUD_INITIAL_TAIL_HOURS=24
# Largest file that can be pulled into a job.
NEXTCLOUD_MAX_IMPORT_MB=80

# --- PostgreSQL database (job/prompt/user persistence) --------------------
# The app reads DATABASE_URL. In Docker Compose it points at the `db` service;
# for local dev point it at a local Postgres. Driver is psycopg 3:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql+psycopg://artwork:change-this-db-password@db:5432/artwork

# These POSTGRES_* vars configure the `db` container (the postgres image reads
# them on first init to create the role + database). Keep them consistent with
# DATABASE_URL above.
POSTGRES_USER=artwork
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=artwork

# How long (seconds) a `running` job with no agent contact is kept running
# across a server restart before being marked interrupted. A container restart
# takes seconds; the designer's agent keeps working and uploads its result.
JOB_RUNNING_GRACE_SECONDS=600
